# Backend Environment Variables Template
# Copy this file to .env.local and fill in your MongoDB Atlas credentials

# MongoDB Atlas Connection
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE
MONGO_URI=mongodb+srv://draftly_dev:YOUR_PASSWORD_HERE@draftly-dev.xxxxx.mongodb.net/draftly?retryWrites=true&w=majority

# Server Port
SERVER_PORT=8080

# Logging
LOGGING_LEVEL=INFO
